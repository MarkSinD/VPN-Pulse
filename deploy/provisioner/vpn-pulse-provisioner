#!/usr/bin/env python3
from __future__ import annotations

import json
import os
import sys

from vpnpulse.provisioner import ProvisionerError, forced_command

try:
    print(json.dumps(forced_command(os.environ.get("SSH_ORIGINAL_COMMAND", "")), separators=(",", ":")))
except (ProvisionerError, OSError, json.JSONDecodeError, KeyError) as error:
    print(json.dumps({"ok": False, "error": type(error).__name__}), file=sys.stdout)
    raise SystemExit(2)

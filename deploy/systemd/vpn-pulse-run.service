[Unit]
Description=VPN Pulse monitoring loop (collect, evaluate, notify)
Documentation=https://github.com/MarkSinD/VPN-Pulse
After=network-online.target vpn-pulse-api.service
Wants=network-online.target

[Service]
Type=simple
User=vpn-pulse
Group=vpn-pulse
Environment=VPN_PULSE_CONFIG=/etc/vpn-pulse/config.yaml
Environment=PYTHONUNBUFFERED=1
# VPN_PULSE_RUN_ARGS=--demo keeps a demo installation's scripted world moving; empty for a real one
EnvironmentFile=-/etc/vpn-pulse/run.env
WorkingDirectory=/var/lib/vpn-pulse
ExecStart=/opt/vpn-pulse/current/venv/bin/vpn-pulse run $VPN_PULSE_RUN_ARGS
Restart=always
RestartSec=10
TimeoutStopSec=20

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
ReadWritePaths=/var/lib/vpn-pulse
ReadOnlyPaths=/etc/vpn-pulse

[Install]
WantedBy=multi-user.target

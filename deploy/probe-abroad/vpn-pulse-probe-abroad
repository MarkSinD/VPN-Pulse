#!/usr/bin/env python3
"""vpn-pulse-probe-abroad — isolated `abroad` and `pc` probes. Python standard library only.

One run is one round: fetch the target list from the API, and for every target bring up a dedicated
AmneziaWG interface inside a network namespace that has no default route, ping the target's tunnel
address, read the handshake age, tear the interface down. Then one ProbeReport goes to the API; when
the API is unreachable the report waits in a 0600 queue on disk (24 hours, 1500 entries at most).

With `KIND=pc`, the same lifecycle adds control-internet and HTTPS checks, a namespace default
route through the tunnel, and public-exit comparisons. The interface is created in the main namespace — its UDP socket keeps the host's route to the
endpoint — and then moved into the namespace, where the only route is the /32 to the target. A torn
tunnel therefore cannot pass by reaching the target directly: that is what `route_verified` claims.
Private keys live only in the peer profiles (0600) on this host; the log names servers by id only.

Two engines: `ENGINE=kernel` (the AmneziaWG kernel module, `ip link add … type amneziawg`) or
`ENGINE=userspace` (`amneziawg-go`, which creates the interface itself). The userspace engine is the
way to match a target that runs a newer AmneziaWG than the host's module — AmneziaWG options such
as random trailers must match on both ends, and the module of one release cannot talk to a server
of the next; taking `amneziawg-go` and `awg` from the same release as the servers side-steps that.
"""
from __future__ import annotations

import json
import os
import subprocess
import sys
import time
import urllib.error
import urllib.request
import uuid
from datetime import datetime, timezone
from pathlib import Path

VERSION = "0.3.0"
DEFAULT_CONFIG = "/etc/vpn-pulse-probe/config"
HANDSHAKE_MAX_AGE = 30  # seconds: the handshake must be from this very check
QUEUE_MAX_AGE = 24 * 3600
QUEUE_MAX_ENTRIES = 1500
STEP_TIMEOUT = 5  # seconds per ip/awg command
PING_TIMEOUT = 10
SOCKET_WAIT = 3  # seconds for amneziawg-go to open its control socket
HANDSHAKE_WAIT = 20  # seconds to let a fresh handshake complete (PersistentKeepalive drives it)


# ---------- configuration ----------
def read_config(path: str) -> dict:
    values = {"KIND": "abroad", "NETNS": "vpprobe", "IFACE": "vpprobe0", "PEERS_DIR": "/etc/vpn-pulse-probe/peers", "STATE_DIR": "/var/lib/vpn-pulse-probe",
              "ENGINE": "kernel", "AWG": "awg", "AWG_QUICK": "awg-quick", "AWG_GO": "amneziawg-go", "AWG_LOADER": "", "SOCKET_DIR": "/var/run/amneziawg",
              "CURL": "curl", "CONTROL_URLS": "https://www.gstatic.com/generate_204,https://example.org/", "HTTPS_URL": "https://www.gstatic.com/generate_204",
              "IP_URL": "https://api.ipify.org", "DNS": "", "NETNS_ETC": "/etc/netns"}
    for raw in Path(path).read_text(encoding="utf-8").splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if "=" not in line:
            raise ValueError("invalid config line")
        key, value = line.split("=", 1)
        values[key.strip()] = value.strip()
    for required in ("API_URL", "TOKEN_FILE", "TARGETS"):
        if not values.get(required):
            raise ValueError(f"{required} is required")
    if values["ENGINE"] not in ("kernel", "userspace"):
        raise ValueError("ENGINE must be kernel or userspace")
    if values["KIND"] not in ("abroad", "pc"):
        raise ValueError("KIND must be abroad or pc")
    if values["KIND"] == "pc" and any(not values.get(key) for key in ("HOME_EXIT", "EXPECTED_EXITS", "DNS")):
        raise ValueError("HOME_EXIT, EXPECTED_EXITS and DNS are required for KIND=pc")
    return values


def awg_command(config: dict) -> list:
    """`awg`, optionally run through a loader (a musl build of the tools on a glibc host: AWG_LOADER=/lib/ld-musl-x86_64.so.1)."""
    return ([config["AWG_LOADER"]] if config["AWG_LOADER"] else []) + [config["AWG"]]


def parse_targets(value: str) -> dict:
    """`id=tunnel-address,id=tunnel-address` → {id: address}."""
    targets = {}
    for item in value.split(","):
        if item.strip():
            name, address = item.split("=", 1)
            targets[name.strip()] = address.strip()
    return targets


def local_address(profile: str) -> str:
    for line in profile.splitlines():
        key, _, value = line.partition("=")
        if key.strip().lower() == "address":
            return value.strip().split(",")[0]
    return ""


# ---------- one check ----------
def check_target(config: dict, target: str, address: str, runner=subprocess.run, clock=time.time) -> dict:
    """Bring the tunnel up, ping through it, read the handshake, tear it down. Returns one ProbeReport result."""
    netns, iface, awg = config["NETNS"], config["IFACE"], awg_command(config)
    inside = ["ip", "netns", "exec", netns]
    started = time.monotonic()
    error = "TUNNEL_SETUP_FAILED"
    success = False

    def run(command, **kwargs):
        return runner(command, capture_output=True, text=True, timeout=kwargs.pop("timeout", STEP_TIMEOUT), check=False, **kwargs)

    def teardown():
        # one of the two fails harmlessly: the interface is in one namespace only; amneziawg-go exits with its interface
        for command in (inside + ["ip", "link", "delete", iface], ["ip", "link", "delete", iface]):
            try:
                run(command)
            except (OSError, subprocess.TimeoutExpired):
                pass

    def create() -> bool:
        if config["ENGINE"] == "kernel":
            return run(["ip", "link", "add", iface, "type", "amneziawg"]).returncode == 0
        if run([config["AWG_GO"], iface]).returncode != 0:  # daemonizes, then opens /var/run/amneziawg/<iface>.sock
            return False
        socket = Path(config["SOCKET_DIR"]) / f"{iface}.sock"
        deadline = time.monotonic() + SOCKET_WAIT
        while not socket.exists() and time.monotonic() < deadline:
            time.sleep(0.1)
        return socket.exists()

    try:
        profile_path = Path(config["PEERS_DIR"]) / f"{target}.conf"
        local = local_address(profile_path.read_text(encoding="utf-8"))
        teardown()  # a crashed previous run may have left the interface behind
        stripped = run([config["AWG_QUICK"], "strip", str(profile_path)])  # the peer section and the AWG parameters, without Address
        ok = stripped.returncode == 0 and bool(local) and create()
        steps = [
            (awg + ["setconf", iface, "/dev/stdin"], {"input": stripped.stdout}),
            (["ip", "link", "set", iface, "netns", netns], {}),
            (inside + ["ip", "address", "add", local, "dev", iface], {}),
            (inside + ["ip", "link", "set", "up", "dev", iface], {}),
            (inside + ["ip", "route", "add", address + "/32", "dev", iface], {}),
        ]
        for command, extra in steps:
            if not ok:
                break
            ok = run(command, **extra).returncode == 0
        if ok:
            ping = run(inside + ["ping", "-c", "2", "-W", "3", address], timeout=PING_TIMEOUT)
            shown = run(inside + awg + ["show", iface, "latest-handshakes"])
            now = clock()
            epochs = [int(line.split()[-1]) for line in shown.stdout.splitlines() if line.split() and line.split()[-1].isdigit()]
            fresh = any(epoch > 0 and 0 <= now - epoch <= HANDSHAKE_MAX_AGE for epoch in epochs)
            if not fresh:
                error = "HANDSHAKE_FAILED"
            elif ping.returncode != 0:
                error = "PING_FAILED"
            else:
                success = True
    except (OSError, subprocess.TimeoutExpired):
        error = "CHECK_TIMEOUT"
    finally:
        teardown()
    result = {"target_id": target, "check": "handshake", "result": "success" if success else "failure", "duration_ms": int((time.monotonic() - started) * 1000)}
    if not success:
        result["error_code"] = error
    return result


def control_internet(config: dict, runner=subprocess.run) -> tuple[bool, str]:
    """Check ordinary internet outside every tunnel and return its public address."""
    ok = 0
    for url in (item.strip() for item in config["CONTROL_URLS"].split(",") if item.strip()):
        try:
            result = runner([config["CURL"], "-fsS", "--max-time", "10", "-o", "/dev/null", url], capture_output=True, text=True, timeout=15, check=False)
            ok += result.returncode == 0
        except (OSError, subprocess.TimeoutExpired):
            pass
    try:
        address = runner([config["CURL"], "-fsS", "--max-time", "10", config["IP_URL"]], capture_output=True, text=True, timeout=15, check=False)
    except (OSError, subprocess.TimeoutExpired):
        return False, ""
    return ok > 0 and address.returncode == 0, address.stdout.strip() if address.returncode == 0 else ""


def check_target_pc(config: dict, target: str, expected_exit: str, runner=subprocess.run, clock=time.time) -> tuple[list[dict], bool]:
    """Run handshake and HTTPS through a full tunnel that has no direct fallback."""
    netns, iface, awg = config["NETNS"], config["IFACE"], awg_command(config)
    inside = ["ip", "netns", "exec", netns]
    started = time.monotonic()

    def run(command, **kwargs):
        return runner(command, capture_output=True, text=True, timeout=kwargs.pop("timeout", STEP_TIMEOUT), check=False, **kwargs)

    def result(check: str, success: bool, error: str) -> dict:
        row = {"target_id": target, "check": check, "result": "success" if success else "failure", "duration_ms": int((time.monotonic() - started) * 1000)}
        if not success:
            row["error_code"] = error
        return row

    def teardown():
        for command in (inside + ["ip", "link", "delete", iface], ["ip", "link", "delete", iface]):
            try:
                run(command)
            except (OSError, subprocess.TimeoutExpired):
                pass

    handshake_ok = https_ok = route_ok = False
    handshake_error = "TUNNEL_SETUP_FAILED"
    https_error = "TUNNEL_SETUP_FAILED"
    try:
        resolv = Path(config["NETNS_ETC"]) / netns / "resolv.conf"
        resolv.parent.mkdir(parents=True, exist_ok=True)
        resolv.write_text(f"nameserver {config['DNS']}\n", encoding="utf-8")
        profile_path = Path(config["PEERS_DIR"]) / f"{target}.conf"
        local = local_address(profile_path.read_text(encoding="utf-8"))
        teardown()
        stripped = run([config["AWG_QUICK"], "strip", str(profile_path)])
        if config["ENGINE"] == "kernel":
            created = run(["ip", "link", "add", iface, "type", "amneziawg"]).returncode == 0
        else:
            created = run([config["AWG_GO"], iface]).returncode == 0
            socket = Path(config["SOCKET_DIR"]) / f"{iface}.sock"
            deadline = time.monotonic() + SOCKET_WAIT
            while created and not socket.exists() and time.monotonic() < deadline:
                time.sleep(0.1)
            created = created and socket.exists()
        ok = stripped.returncode == 0 and bool(local) and created
        steps = [
            (awg + ["setconf", iface, "/dev/stdin"], {"input": stripped.stdout}),
            (["ip", "link", "set", iface, "netns", netns], {}),
            (inside + ["ip", "address", "add", local, "dev", iface], {}),
            (inside + ["ip", "link", "set", "up", "dev", iface], {}),
            (inside + ["ip", "route", "add", "default", "dev", iface], {}),
        ]
        for command, extra in steps:
            if not ok:
                break
            ok = run(command, **extra).returncode == 0
        if ok:
            # A handshake needs a moment, and PersistentKeepalive in the profiles starts it
            # without any traffic of ours. The abroad path gets that moment from its ping;
            # this one had no pause at all, so latest-handshakes was always still zero and
            # KIND=pc could never report a successful handshake. Wait, as pc-check.sh does.
            handshake_deadline = time.monotonic() + HANDSHAKE_WAIT
            while True:
                shown = run(inside + awg + ["show", iface, "latest-handshakes"])
                epochs = [int(line.split()[-1]) for line in shown.stdout.splitlines() if line.split() and line.split()[-1].isdigit()]
                handshake_ok = any(epoch > 0 and 0 <= clock() - epoch <= HANDSHAKE_MAX_AGE for epoch in epochs)
                if handshake_ok or time.monotonic() >= handshake_deadline:
                    break
                time.sleep(1)
            handshake_error = "HANDSHAKE_FAILED"
            if handshake_ok:
                code = run(inside + [config["CURL"], "-sS", "--max-time", "10", "-o", "/dev/null", "-w", "%{http_code}", config["HTTPS_URL"]], timeout=15)
                https_ok = code.returncode == 0 and code.stdout.strip() == "204"
                https_error = "HTTPS_FAILED"
                exit_result = run(inside + [config["CURL"], "-fsS", "--max-time", "10", config["IP_URL"]], timeout=15)
                route_ok = exit_result.returncode == 0 and exit_result.stdout.strip() == expected_exit
    except (OSError, subprocess.TimeoutExpired):
        handshake_error = https_error = "CHECK_TIMEOUT"
    finally:
        teardown()
    return [result("handshake", handshake_ok, handshake_error), result("https", https_ok, https_error)], route_ok


# ---------- the API ----------
def request_json(url: str, *, token: str | None = None, payload: dict | None = None, timeout: int = 15) -> dict:
    data = None if payload is None else json.dumps(payload, separators=(",", ":")).encode()
    headers = {"Accept": "application/json", "User-Agent": f"vpn-pulse-probe-abroad/{VERSION}"}
    if data is not None:
        headers["Content-Type"] = "application/json"
    if token:
        headers["Authorization"] = "Bearer " + token
    with urllib.request.urlopen(urllib.request.Request(url, data=data, headers=headers), timeout=timeout) as response:
        return json.loads(response.read().decode())


def queue_path(config: dict) -> Path:
    return Path(config["STATE_DIR"]) / "queue.jsonl"


def load_queue(config: dict, clock=time.time) -> list:
    path = queue_path(config)
    if not path.exists():
        return []
    cutoff = clock() - QUEUE_MAX_AGE
    rows = []
    for line in path.read_text(encoding="utf-8").splitlines()[-QUEUE_MAX_ENTRIES:]:
        try:
            row = json.loads(line)
        except ValueError:
            continue
        if isinstance(row, dict) and row.get("queued_at", 0) >= cutoff:
            rows.append(row)
    return rows


def save_queue(config: dict, rows: list) -> None:
    path = queue_path(config)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text("".join(json.dumps(row, separators=(",", ":")) + "\n" for row in rows[-QUEUE_MAX_ENTRIES:]), encoding="utf-8")
    os.chmod(path, 0o600)


def tick(config: dict, runner=subprocess.run, clock=time.time) -> int:
    token = Path(config["TOKEN_FILE"]).read_text(encoding="utf-8").strip()
    base = config["API_URL"].rstrip("/")
    allowed = {item["id"] for item in request_json(base + "/api/v1/probe/config", token=token)["targets"]}
    targets = {target: address for target, address in parse_targets(config["TARGETS"]).items() if target in allowed}
    route_verified = True
    network_type = "abroad"
    if config["KIND"] == "pc":
        network_type = "home"
        expected = parse_targets(config["EXPECTED_EXITS"])
        control_ok, home_exit = control_internet(config, runner)
        route_verified = control_ok and home_exit == config["HOME_EXIT"]
        results = []
        for target in targets:
            control = {"target_id": target, "check": "control_internet", "result": "success" if control_ok else "failure", "duration_ms": 0}
            if not control_ok:
                control["error_code"] = "CONTROL_INTERNET_FAILED"
            results.append(control)
            checked, target_route = check_target_pc(config, target, expected.get(target, ""), runner, clock)
            results.extend(checked)
            route_verified = route_verified and target_route
    else:
        results = [check_target(config, target, address, runner, clock) for target, address in targets.items()]
    if not results:
        print("no targets", file=sys.stderr)
        return 1
    report = {
        "report_id": str(uuid.uuid4()), "schema_version": 1, "agent_version": VERSION,
        "observed_at": datetime.now(timezone.utc).isoformat().replace("+00:00", "Z"),
        "network": {"type": network_type, "ip_family": "ipv4", "route_verified": route_verified}, "results": results,
    }
    # oldest first; whatever cannot be sent now stays queued (sent rows are dropped, so nothing is repeated)
    pending = load_queue(config, clock) + [{"queued_at": clock(), "report": report}]
    while pending:
        try:
            request_json(base + "/api/v1/probe/reports", token=token, payload=pending[0]["report"])
        except (OSError, ValueError, KeyError):
            save_queue(config, pending)
            print(" ".join(f"{r['target_id']}={r['result']}" for r in results) + f" (queued {len(pending)})")
            return 1
        pending.pop(0)
    save_queue(config, [])
    print(" ".join(f"{r['target_id']}={r['result']}" for r in results))
    return 0


def enroll(config: dict, code: str) -> None:
    answer = request_json(config["API_URL"].rstrip("/") + "/api/v1/probe/enroll", payload={"code": code, "agent_version": VERSION, "schema_version": 1})
    path = Path(config["TOKEN_FILE"])
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(answer["token"] + "\n", encoding="utf-8")
    os.chmod(path, 0o600)
    print("enrolled")


def main() -> int:
    try:
        config = read_config(os.environ.get("VPN_PULSE_PROBE_CONFIG", DEFAULT_CONFIG))
        if len(sys.argv) == 3 and sys.argv[1] == "enroll":
            enroll(config, sys.argv[2])
            return 0
        if len(sys.argv) != 1:
            raise ValueError("usage: vpn-pulse-probe-abroad [enroll CODE]")
        return tick(config)
    except Exception as error:  # noqa: BLE001 - the type is the whole diagnosis; nothing secret is printed
        print("probe failed: " + type(error).__name__, file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())

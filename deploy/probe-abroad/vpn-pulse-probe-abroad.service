[Unit]
Description=VPN Pulse cross-server probe
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
# the namespace does not survive a reboot: recreate it when it is missing ('+': outside the sandbox, /run is read-only inside)
ExecStartPre=+/bin/sh -c 'test -e /run/netns/vpprobe || ip netns add vpprobe'
ExecStart=/usr/local/bin/vpn-pulse-probe-abroad
Environment=VPN_PULSE_PROBE_CONFIG=/etc/vpn-pulse-probe/config
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/vpn-pulse-probe /etc/vpn-pulse-probe
# amneziawg-go (ENGINE=userspace) keeps its control socket in /run/amneziawg
RuntimeDirectory=amneziawg
RuntimeDirectoryPreserve=yes
MemoryMax=64M

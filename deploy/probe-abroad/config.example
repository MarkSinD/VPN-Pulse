API_URL=https://monitor.example.org
TOKEN_FILE=/etc/vpn-pulse-probe/token
# abroad: server-to-server handshake; pc: full-tunnel checks from a home VM
KIND=abroad
NETNS=vpprobe
IFACE=vpprobe0
PEERS_DIR=/etc/vpn-pulse-probe/peers
STATE_DIR=/var/lib/vpn-pulse-probe
# server id (from config.yaml) = that server's tunnel address, comma-separated
TARGETS=primary=192.0.2.1,backup=198.51.100.1
# kernel: the AmneziaWG kernel module; userspace: amneziawg-go from the same release as the targets
ENGINE=kernel
#ENGINE=userspace
#AWG_GO=/opt/vpn-pulse-probe/awg/amneziawg-go
#AWG=/opt/vpn-pulse-probe/awg/awg
#AWG_LOADER=/lib/ld-musl-x86_64.so.1   # only for a musl build of awg on a glibc host

# KIND=pc only. Keep real addresses in the private host config, never in this repository.
#HOME_EXIT=198.51.100.10
#EXPECTED_EXITS=primary=203.0.113.10,backup=203.0.113.11
#CONTROL_URLS=https://www.gstatic.com/generate_204,https://example.org/
#HTTPS_URL=https://www.gstatic.com/generate_204
#IP_URL=https://api.ipify.org
#DNS=192.0.2.53
